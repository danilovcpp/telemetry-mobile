<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:c="clr-namespace:TelemetryMobile.UI.Components" x:Class="TelemetryMobile.UI.Components.SummaryStatCard" x:Name="Root" x:DataType="c:SummaryStatCard">

    <Border Style="{StaticResource SummaryCard}">
        <VerticalStackLayout Spacing="{StaticResource Space4}">
            <Label x:Name="ValueLabel" Text="{Binding Value, Source={x:Reference Root}}" Style="{StaticResource MetricValueLabelStyle}" />
            <Label Text="{Binding Caption, Source={x:Reference Root}}" Style="{StaticResource BodySecondaryLabelStyle}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
