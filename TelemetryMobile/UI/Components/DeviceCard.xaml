<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:theme="clr-namespace:TelemetryMobile.Theming" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:c="clr-namespace:TelemetryMobile.UI.Components" x:Class="TelemetryMobile.UI.Components.DeviceCard" x:Name="Root" x:DataType="c:DeviceCard">

    <Border Style="{StaticResource InteractiveCard}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource Space8}" RowSpacing="{StaticResource Space4}">
            <Border Grid.RowSpan="3" BackgroundColor="{DynamicResource ColorSurfaceElevated}" StrokeThickness="0" StrokeShape="{StaticResource ShapePill}" Padding="12" VerticalOptions="Center">
                <Image Source="{Binding Icon, Source={x:Reference Root}}" WidthRequest="28" HeightRequest="28" AutomationProperties.IsInAccessibleTree="False"><Image.Behaviors><toolkit:IconTintColorBehavior TintColor="{Binding IconTintColor, Source={x:Static theme:ThemeManager.Instance}, x:DataType=theme:ThemeManager}" /></Image.Behaviors></Image>
            </Border>
            <Label Grid.Column="1" Text="{Binding Name, Source={x:Reference Root}}" Style="{StaticResource CardTitleLabelStyle}" />
            <Label Grid.Column="1" Grid.Row="1" Text="{Binding SecondaryText, Source={x:Reference Root}}" Style="{StaticResource BodySecondaryLabelStyle}" />
            <c:StatusBadge x:Name="DeviceStatus" Grid.Column="1" Grid.Row="2" Text="{Binding StatusText, Source={x:Reference Root}}" State="{Binding State, Source={x:Reference Root}}" VerticalOptions="Center" />
            <Image Grid.Column="3" Grid.RowSpan="3" Source="chevron.png" IsVisible="{Binding ShowNavigation, Source={x:Reference Root}}" WidthRequest="{StaticResource IconSizeSmall}" HeightRequest="{StaticResource IconSizeSmall}" AutomationProperties.IsInAccessibleTree="False"><Image.Behaviors><toolkit:IconTintColorBehavior TintColor="{Binding IconTintColor, Source={x:Static theme:ThemeManager.Instance}, x:DataType=theme:ThemeManager}" /></Image.Behaviors></Image>
            <Button Grid.ColumnSpan="4" Grid.RowSpan="3" Command="{Binding Command, Source={x:Reference Root}}" CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" IsVisible="{Binding IsInteractive, Source={x:Reference Root}}"
                Style="{StaticResource CardActionButtonStyle}" SemanticProperties.Description="{Binding Name, Source={x:Reference Root}}" />
        </Grid>
    </Border>
</ContentView>
