<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:c="clr-namespace:TelemetryMobile.UI.Components" x:Class="TelemetryMobile.UI.Components.EventListItem" x:Name="Root" x:DataType="c:EventListItem">

    <Grid Style="{StaticResource CollectionItemStyle}" RowDefinitions="Auto,Auto,Auto,Auto">
        <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource CardTitleLabelStyle}" />
        <Label Grid.Row="1" Text="{Binding Description, Source={x:Reference Root}}" Style="{StaticResource BodySecondaryLabelStyle}" />
        <c:StatusBadge Grid.Row="2" Text="{Binding StatusText, Source={x:Reference Root}}" State="{Binding State, Source={x:Reference Root}}" />
        <Label Grid.Row="3" Text="{Binding Timestamp, Source={x:Reference Root}}" Style="{StaticResource TimestampLabelStyle}" />
    </Grid>
</ContentView>
