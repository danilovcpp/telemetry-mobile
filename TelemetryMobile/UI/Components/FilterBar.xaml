<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:c="clr-namespace:TelemetryMobile.UI.Components" xmlns:vm="clr-namespace:TelemetryMobile.PageModels"
 x:Class="TelemetryMobile.UI.Components.FilterBar" x:Name="Root" x:DataType="c:FilterBar">
    <ContentView.Resources>
        <Style x:Key="FilterChipStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceCard}" />
            <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
            <Setter Property="BorderColor" Value="{DynamicResource ColorBorderSubtle}" />
            <Setter Property="BorderWidth" Value="{StaticResource BorderWidth}" />
            <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodySecondary}" />
            <Setter Property="FontAttributes" Value="None" />
        </Style>
    </ContentView.Resources>
    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
        <HorizontalStackLayout Spacing="{StaticResource Space8}" BindableLayout.ItemsSource="{Binding Items, Source={x:Reference Root}}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterOption">
                    <Button Text="{Binding Caption}" Command="{Binding Command}" CommandParameter="{Binding Value}"
                        Style="{StaticResource FilterChipStyle}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource ColorAccentPrimary}" />
                                <Setter Property="TextColor" Value="{DynamicResource ColorTextOnAccent}" />
                                <Setter Property="BorderColor" Value="{DynamicResource ColorAccentPrimary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
    </ScrollView>
</ContentView>
