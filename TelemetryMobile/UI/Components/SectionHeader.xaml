<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:c="clr-namespace:TelemetryMobile.UI.Components" x:Class="TelemetryMobile.UI.Components.SectionHeader" x:Name="Root" x:DataType="c:SectionHeader">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space8}">
        <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource SectionTitleLabelStyle}" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
        <Button Grid.Column="1" Text="{Binding ActionText, Source={x:Reference Root}}" Command="{Binding ActionCommand, Source={x:Reference Root}}" CommandParameter="{Binding ActionParameter, Source={x:Reference Root}}" IsVisible="{Binding HasAction, Source={x:Reference Root}}" Style="{StaticResource TextButtonStyle}" />
    </Grid>
</ContentView>
