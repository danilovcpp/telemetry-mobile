<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:c="clr-namespace:TelemetryMobile.UI.Components" x:Class="TelemetryMobile.UI.Components.MetricRow" x:Name="Root" x:DataType="c:MetricRow">

    <Grid Style="{StaticResource CollectionItemStyle}" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
        <Image Source="{Binding Icon, Source={x:Reference Root}}" Grid.RowSpan="3" WidthRequest="{StaticResource IconSize}" HeightRequest="{StaticResource IconSize}" AutomationProperties.IsInAccessibleTree="False" />
        <Label Grid.Column="1" Text="{Binding Name, Source={x:Reference Root}}" Style="{StaticResource BodySecondaryLabelStyle}" />
        <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="{StaticResource Space4}">
            <Label Text="{Binding Value, Source={x:Reference Root}}" Style="{StaticResource CardTitleLabelStyle}" />
            <Label Text="{Binding Unit, Source={x:Reference Root}}" Style="{StaticResource BodySecondaryLabelStyle}" VerticalOptions="End" />
        </HorizontalStackLayout>
        <Label Grid.Column="1" Grid.Row="2" Text="{Binding Trend, Source={x:Reference Root}}" Style="{StaticResource CaptionLabelStyle}" />
    </Grid>
</ContentView>
