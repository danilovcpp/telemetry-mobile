<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:c="clr-namespace:TelemetryMobile.UI.Components" xmlns:vm="clr-namespace:TelemetryMobile.PageModels"
 xmlns:loc="clr-namespace:TelemetryMobile.Localization" xmlns:theme="clr-namespace:TelemetryMobile.Theming"
 xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
 x:Class="TelemetryMobile.Pages.DeviceDetailsPage" x:DataType="vm:DeviceDetailsPageModel"
 Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False" SafeAreaEdges="All">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{Binding PageBackgroundColor, Source={x:Static theme:ThemeManager.Instance}, x:DataType=theme:ThemeManager}"
            StatusBarStyle="{Binding StatusBarStyle, Source={x:Static theme:ThemeManager.Instance}, x:DataType=theme:ThemeManager}" />
    </ContentPage.Behaviors>
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}" RefreshColor="{DynamicResource ColorAccentPrimary}">
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SectionSpacing}"
            MaximumWidthRequest="{StaticResource ContentMaxWidth}" HorizontalOptions="Fill">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="‹" Style="{StaticResource IconButtonStyle}" Clicked="OnBackClicked" SemanticProperties.Description="{loc:Translate Back}" />
                <Button Grid.Column="1" Text="{loc:Translate Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource TextButtonStyle}" />
                <Button Grid.Column="2" Text="⋮" Style="{StaticResource IconButtonStyle}" Clicked="OnMenuClicked" SemanticProperties.Description="{loc:Translate Menu}" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ColorAccentPrimary}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource ColorStatusError}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space20}" RowSpacing="{StaticResource Space8}">
                <Border Grid.RowSpan="2" BackgroundColor="{DynamicResource ColorSurfaceElevated}" StrokeThickness="0" StrokeShape="{StaticResource ShapeExtraLarge}" Padding="20" VerticalOptions="Start">
                    <Image Source="sensor.png" WidthRequest="48" HeightRequest="64" AutomationProperties.IsInAccessibleTree="False">
                        <Image.Behaviors><toolkit:IconTintColorBehavior TintColor="{Binding IconTintColor, Source={x:Static theme:ThemeManager.Instance}, x:DataType=theme:ThemeManager}" /></Image.Behaviors>
                    </Image>
                </Border>
                <Label Grid.Column="1" Text="{Binding Device.Name}" Style="{StaticResource SectionTitleLabelStyle}" SemanticProperties.HeadingLevel="Level1" />
                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Device.Address}" Style="{StaticResource BodySecondaryLabelStyle}" />
            </Grid>
            <Border Style="{StaticResource StandardCard}">
                <Grid ColumnDefinitions="*,1.2*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource Space12}" RowSpacing="{StaticResource Space16}">
                    <Label Text="{loc:Translate DeviceCode}" Style="{StaticResource BodySecondaryLabelStyle}" />
                    <Label Grid.Column="1" Text="{Binding Device.Address}" HorizontalTextAlignment="End" />
                    <Label Grid.Row="1" Text="{loc:Translate LastEvent}" Style="{StaticResource BodySecondaryLabelStyle}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding LastContact}" HorizontalTextAlignment="End" />
                    <Label Grid.Row="2" Text="{loc:Translate LastStatus}" Style="{StaticResource BodySecondaryLabelStyle}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding LastStatus}" HorizontalTextAlignment="End" />
                </Grid>
            </Border>
            <c:SectionHeader Title="{loc:Translate Events}" ActionText="{loc:Translate All}" ActionCommand="{Binding AllEventsCommand}" />
            <Border Style="{StaticResource StandardCard}" Padding="16,0">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentEvents}">
                    <BindableLayout.EmptyView><Label Text="{loc:Translate NoEvents}" IsVisible="{Binding ShowEmpty}" Style="{StaticResource BodySecondaryLabelStyle}" Margin="0,16" /></BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EventItem">
                            <VerticalStackLayout>
                                <c:EventListItem Title="{Binding Title}" Timestamp="{Binding Timestamp}" State="{Binding State}" StatusText="{Binding Title}" />
                                <Label Text="{Binding Payload}" IsVisible="{Binding HasPayload}" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,0,16" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    </RefreshView>
</ContentPage>
