    <x:Double x:Key="FontSizeCardTitle">17</x:Double>
    <x:Double x:Key="FontSizeBody">16</x:Double>
    <x:Double x:Key="FontSizeBodySecondary">15</x:Double>
    <x:Double x:Key="FontSizeCaption">13</x:Double>
    <x:Double x:Key="FontSizeMetricValue">28</x:Double>
    <x:Double x:Key="FontSizeButtonText">20</x:Double>
    <x:Double x:Key="FontSizeStatusText">14</x:Double>
    <x:Double x:Key="LineHeightBody">1.3</x:Double>
    <x:Double x:Key="LineHeightHeading">1.12</x:Double>
</ResourceDictionary>
