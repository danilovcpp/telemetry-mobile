<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Dimensions.xaml" />
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorTransparent}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="InputBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceInput}" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBorderSubtle}" />
        <Setter Property="StrokeThickness" Value="{StaticResource BorderWidth}" />
        <Setter Property="StrokeShape" Value="{StaticResource ShapeLarge}" />
        <Setter Property="Padding" Value="{StaticResource InputPadding}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource InputMinHeight}" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource ColorAccentPrimary}" />
    </Style>

</ResourceDictionary>
