<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="CollectionItemStyle" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="ColumnSpacing" Value="{StaticResource ContentSpacing}" />
        <Setter Property="RowSpacing" Value="{StaticResource Space4}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
    </Style>
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorPageBackground}" />
        <Setter Property="SafeAreaEdges" Value="All" />
    </Style>
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorPageBackground}" />
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource ColorPageBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource ColorTextPrimary}" />
    </Style>

</ResourceDictionary>
