<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Dimensions.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="StandardCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceCard}" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBorderSubtle}" />
        <Setter Property="StrokeThickness" Value="{StaticResource BorderWidth}" />
        <Setter Property="StrokeShape" Value="{StaticResource ShapeLarge}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>
    <Style x:Key="ElevatedCard" TargetType="Border" BasedOn="{StaticResource StandardCard}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceElevated}" />
    </Style>
    <Style x:Key="InteractiveCard" TargetType="Border" BasedOn="{StaticResource StandardCard}">
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
    </Style>
    <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource StandardCard}" />
    <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceElevated}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="{StaticResource ShapePill}" />
        <Setter Property="Padding" Value="{StaticResource BadgePadding}" />
    </Style>

</ResourceDictionary>
