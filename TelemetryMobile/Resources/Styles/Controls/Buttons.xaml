<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Dimensions.xaml" />
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ButtonMinHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeButtonText}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextOnAccent}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorAccentPrimary}" />
        
        
        
        <Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
<VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="{DynamicResource ColorAccentPrimary}" /><Setter Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
<VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="{DynamicResource ColorAccentPressed}" /></VisualState.Setters></VisualState>
<VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
</VisualStateGroup></VisualStateGroupList></Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceElevated}" />
        
        
        
        <Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
<VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceElevated}" /><Setter Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
<VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="{DynamicResource ColorBorderSubtle}" /></VisualState.Setters></VisualState>
<VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
</VisualStateGroup></VisualStateGroupList></Setter>
    </Style>

    <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorTransparent}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorAccentPrimary}" />
        
        <Setter Property="BorderColor" Value="{DynamicResource ColorBorderSubtle}" /><Setter Property="BorderWidth" Value="{StaticResource BorderWidth}" />
        <Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
<VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="{DynamicResource ColorTransparent}" /><Setter Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
<VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceElevated}" /></VisualState.Setters></VisualState>
<VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
</VisualStateGroup></VisualStateGroupList></Setter>
    </Style>

    <Style x:Key="TextButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorTransparent}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorAccentPrimary}" />
        
        
        <Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
<VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="{DynamicResource ColorTransparent}" /><Setter Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
<VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceElevated}" /></VisualState.Setters></VisualState>
<VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
</VisualStateGroup></VisualStateGroupList></Setter>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorStatusError}" />
        
        <Setter Property="TextColor" Value="{DynamicResource ColorTextOnStatus}" />
        
        <Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
<VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="{DynamicResource ColorStatusError}" /><Setter Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
<VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="{DynamicResource ColorStatusErrorPressed}" /></VisualState.Setters></VisualState>
<VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
</VisualStateGroup></VisualStateGroupList></Setter>
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
        <Setter Property="Padding" Value="{StaticResource IconPadding}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="FontSize" Value="{StaticResource IconSize}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}" />
    <!-- Transparent native action over a card; pressed tint keeps its content readable. -->
    <Style x:Key="CardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorTransparent}" />
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorAccentPrimary}" />
                            <Setter Property="Opacity" Value="0.12" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorTransparent}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>
